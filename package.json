{
  "name": "comizy-dl",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser.mjs",
    "reassemble": "node scripts/reassemble.mjs",
    "lint:addon": "node scripts/web-ext.mjs lint --source-dir dist --warnings-as-errors",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:addon",
    "dev": "npm run build && node scripts/web-ext.mjs run --source-dir dist",
    "package": "npm run build && node scripts/web-ext.mjs build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "release": "node scripts/release.mjs",
    "package:source": "node scripts/source-package.mjs",
    "sign:unlisted": "node scripts/sign-unlisted.mjs",
    "reassemble:cbz": "node scripts/reassemble-cbz.mjs",
    "test:reassemble": "node scripts/test-reassemble.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0"
  },
  "license": "MIT"
}
