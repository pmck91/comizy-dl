{
  "manifest_version": 3,
  "name": "comizy-dl",
  "version": "0.3.1",
  "description": "Download selected Comizy chapters as page images or CBZ archives.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mangadl-comizy@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "https://comizy.io/*",
    "https://*.cmzcdn.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "comizy-dl — Download Comizy chapters",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://comizy.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
